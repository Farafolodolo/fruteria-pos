# Frutería POS — Ejemplo de variables de entorno (NO guardar secretos reales aquí)
# El proyecto funciona sin archivo .env usando estos valores por defecto.

# Puerto del servidor Express (por defecto: 3001)
PORT=3001

# Entorno de ejecución (development | production | test)
NODE_ENV=development

# Ruta de la base de datos SQLite local (por defecto en server/prisma/schema.prisma)
DATABASE_URL="file:./dev.db"
